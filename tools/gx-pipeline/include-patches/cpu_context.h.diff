+// Envoltorios para el codigo recompilado: misma funcion, llamada declarada sin captura del contexto.
+namespace nwii::runtime {
+template <class R, class... A> PORT_FI auto port_ne(R (*f)(CPUContext &, A...)) { return reinterpret_cast<R (*)(CPUContext & PORT_NOESC, A...)>(f); }
+template <class R, class... A> PORT_FI auto port_ne(R (*f)(const CPUContext &, A...)) { return reinterpret_cast<R (*)(const CPUContext & PORT_NOESC, A...)>(f); }
+PORT_FI bool port_ne_ppc(CPUContext &c) { return reinterpret_cast<bool (*)(CPUContext & PORT_NOESC)>(&process_pending_callbacks)(c); }
+PORT_FI bool port_ne_syscall(CPUContext &c) { return reinterpret_cast<bool (*)(CPUContext & PORT_NOESC)>(&handle_syscall)(c); }
+// Diagnostico: entradas al interprete desde el codigo compactado (direccion de reentrada sin etiqueta).
+inline uint64_t g_port_interp_steps = 0;
+// NWII_DIRECT_CALLS=0: las llamadas indirectas y saltos de cola vuelven al despachador como antes.
+inline const bool g_port_dcalls = [] { const char* e = std::getenv("NWII_DIRECT_CALLS"); return !(e && e[0] == '0'); }();
+PORT_FI void port_ne_interp(CPUContext &c) { ++g_port_interp_steps; reinterpret_cast<void (*)(CPUContext & PORT_NOESC)>(&interpret_step)(c); }
+PORT_FI void port_ne_trace(uint32_t a, CPUContext &c) { reinterpret_cast<void (*)(uint32_t, CPUContext & PORT_NOESC)>(&trace_call)(a, c); }
